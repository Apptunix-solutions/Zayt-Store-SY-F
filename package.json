    "date-fns": "^4.4.0",
    "lucide-vue-next": "^1.0.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vee-validate": "^4.15.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.17",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^30.0.0",
